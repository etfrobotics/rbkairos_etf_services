<launch>

  <!-- ============================================================= -->
  <!-- bringup_sim.launch                                            -->
  <!--                                                               -->
  <!-- SIM-integration: launches two independent PROST planning       -->
  <!-- stacks, one per robot.  Each stack owns:                      -->
  <!--   * a prost_bridge node (separate TCP port)                   -->
  <!--   * a service_caller node pointing at that bridge             -->
  <!--                                                               -->
  <!-- Run with dry_run:=true (default) to skip action-server calls  -->
  <!-- and test only the planner loop.                               -->
  <!-- ============================================================= -->

  <arg name="dry_run"        default="false"  />
  <arg name="domain_name"    default="fruit_collection_domain.rddl" />
  <arg name="prost_path"     default="$(find prost_ros)/prost/prost.py" />
  <arg name="search_engine"  default="[Prost -s 1 -se [IPC2014 -t 1.0]]" />

  <!-- ============================================================= -->
  <!-- Robot 1 planning stack — aisle 1, port 2323                  -->
  <!-- ============================================================= -->
  <group ns="robot1">

    <node pkg="prost_ros"
          type="prost_bridge.py"
          name="prost_bridge"
          output="screen"
          cwd="node">
      <param name="port"          value="2323" />
      <param name="prost_path"    value="$(arg prost_path)" />
      <param name="search_engine" value="$(arg search_engine)" />
    </node>

    <node pkg="rbkairos_etf_services"
          type="service_caller.py"
          name="service_caller"
          output="screen">
      <param name="prost_bridge_ns" value="/robot1/prost_bridge" />
      <param name="domain_name"     value="$(arg domain_name)" />
      <param name="instance_name"   value="instance_robot1.rddl" />
      <param name="dry_run"         value="$(arg dry_run)" />
    </node>

  </group>

  <!-- ============================================================= -->
  <!-- Robot 2 planning stack — aisle 2, port 2324                  -->
  <!-- ============================================================= -->
  <group ns="robot2">

    <node pkg="prost_ros"
          type="prost_bridge.py"
          name="prost_bridge"
          output="screen"
          cwd="node">
      <param name="port"          value="2324" />
      <param name="prost_path"    value="$(arg prost_path)" />
      <param name="search_engine" value="$(arg search_engine)" />
    </node>

    <node pkg="rbkairos_etf_services"
          type="service_caller.py"
          name="service_caller"
          output="screen">
      <param name="prost_bridge_ns" value="/robot2/prost_bridge" />
      <param name="domain_name"     value="$(arg domain_name)" />
      <param name="instance_name"   value="instance_robot2.rddl" />
      <param name="dry_run"         value="$(arg dry_run)" />
      <param name="startup_delay"   value="15.0" />
    </node>

  </group>

</launch>
