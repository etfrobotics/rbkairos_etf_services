////////////////////////////////////////////////////////////////////
// Single-robot instance — robot2, aisle 2 only
// SIM-integration branch: per-robot PROST instance, max-nondef-actions=1
// Reduced capacity (MAX_CAPACITY=3.5, CAPACITY_THRESHOLD=3.0) to
// force the planner into multi-trip-to-unload behaviour.
////////////////////////////////////////////////////////////////////

non-fluents fruit_robot2_nf {
    domain = fruit_collection_multi_aisle;

    objects {
        location      : {l5, l6, l7, l8};
        aisle_position: {a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, unload};
        robot         : {robot2};
    };

    non-fluents {

        // === UNLOAD STATIONS ===
        unload_station(unload);

        // === ADJACENCY (aisle 2 only — robot2 cannot reach aisle 1) ===
        adjacent(a1, a7);    adjacent(a7, a1);
        adjacent(a7, a8);    adjacent(a8, a7);
        adjacent(a8, a9);    adjacent(a9, a8);
        adjacent(a9, a10);   adjacent(a10, a9);
        adjacent(a10, a11);  adjacent(a11, a10);

        // Connection to unload station (via a1)
        adjacent(a1, unload); adjacent(unload, a1);

        // === REACHABILITY (aisle 2 fruits) ===
        reachable_from(l5, a8);
        reachable_from(l6, a9);
        reachable_from(l7, a10);
        reachable_from(l8, a11);

        // === DISTANCES (aisle 2) ===
        distance(a1, a7)     = 3.000; distance(a7, a1)     = 3.000;
        distance(a7, a8)     = 1.000; distance(a8, a7)     = 1.000;
        distance(a8, a9)     = 1.000; distance(a9, a8)     = 1.000;
        distance(a9, a10)    = 1.000; distance(a10, a9)    = 1.000;
        distance(a10, a11)   = 1.000; distance(a11, a10)   = 1.000;
        distance(a1, unload) = 3.000; distance(unload, a1) = 3.000;

        // === ROBOT PARAMETERS ===
        GRASP_SUCCESS_PROB = 0.65;
        MAX_CAPACITY       = 3.5;
        CAPACITY_THRESHOLD = 3.0;

        // === FRUIT WEIGHTS (aisle 2) ===
        fruit_weight(l5) = 1.3;
        fruit_weight(l6) = 0.9;
        fruit_weight(l7) = 0.8;
        fruit_weight(l8) = 0.9;

        // === FRUIT RIPENESS ===
        fruit_ripe(l5) = true;
        fruit_ripe(l6) = true;
        fruit_ripe(l7) = true;
        fruit_ripe(l8) = true;
    };
}

instance fruit_collection_inst_robot2 {
    domain = fruit_collection_multi_aisle;
    non-fluents = fruit_robot2_nf;

    init-state {
        robot_at(robot2, a7);

        fruit_at(l5);
        fruit_at(l6);
        fruit_at(l7);
        fruit_at(l8);
    };

    max-nondef-actions = 1;
    horizon = 120;
    discount = 1.0;
}
