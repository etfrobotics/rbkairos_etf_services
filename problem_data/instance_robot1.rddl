instance fruit_inst_R1 {
    domain = fruit_collection_multi_aisle;
    non-fluents = fruit_robot1_nf;

    init-state {
        // Robot1: Starts at waypoint 'a1' (Aisle 1)
        robot_at(robot1, a1);

        // All fruits initially present
        fruit_at(l1);
        fruit_at(l2);
        fruit_at(l3);
        fruit_at(l4);
        fruit_at(l5);
        fruit_at(l6);
