        distance(a9, unload1) = 4.3345;
        distance(unload1, a9) = 4.3345;
        distance(a17, unload1) = 8.3345;
        distance(unload1, a17) = 8.3345;
        distance(a8, unload2) = 15.8345;
        distance(unload2, a8) = 15.8345;
        distance(a16, unload2) = 12.3345;
        distance(unload2, a16) = 12.3345;
        distance(a20, unload2) = 22.0967;
        distance(unload2, a20) = 22.0967;

        // Robot parameters
        GRASP_SUCCESS_PROB = 0.91;
        MAX_CAPACITY = 45.0;
        CAPACITY_THRESHOLD = 40.0;

        // fruit properties
        fruit_weight(l1) = 1.2;
        fruit_weight(l2) = 1.1;
        fruit_weight(l3) = 0.9;
        fruit_weight(l4) = 1.4;
        fruit_weight(l5) = 1.6;
