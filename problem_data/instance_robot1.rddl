        reachable_from(l61, a20); 
        reachable_from(l62, a20);  
        reachable_from(l63, a20);  
        reachable_from(l64, a20);  

        // distances
        // Aisle 1 
        distance(a1, a2) = 3.4406;
        distance(a2, a1) = 3.4406;
        distance(a2, a3) = 3.4406;
        distance(a3, a2) = 3.4406;
        distance(a3, a4) = 3.4406;
