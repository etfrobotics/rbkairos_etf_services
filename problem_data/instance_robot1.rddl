        reachable_from(l35, a13);  
        reachable_from(l36, a13);  
        reachable_from(l37, a14);  
        reachable_from(l38, a14);  
        reachable_from(l39, a14);  
        reachable_from(l40, a14);  
        reachable_from(l41, a15);  
        reachable_from(l42, a15);  
        reachable_from(l43, a15);  
        reachable_from(l44, a15);  
        reachable_from(l45, a16);  
        reachable_from(l46, a16);  
        reachable_from(l47, a16); 
        reachable_from(l48, a16);  

        // Aisle 3 partial (a17-a20): 4 fruits/waypoint
        reachable_from(l49, a17);  
        reachable_from(l50, a17);  
        reachable_from(l51, a17);  
        reachable_from(l52, a17);  
        reachable_from(l53, a18);  
